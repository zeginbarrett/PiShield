[Unit]
Description=PiShield Sentinel DNS security analysis
After=network-online.target pihole-FTL.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/pishield-sentinel/sentinel.py
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pishield-sentinel /var/www/html/admin
# FTL SQLite WAL may require read-write access to existing shared memory file; DB is opened read-only.
ReadWritePaths=/etc/pihole
